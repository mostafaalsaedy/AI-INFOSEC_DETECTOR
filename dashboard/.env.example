# Base URL of the InfoSec AI Monitor API. Used by the dev-server proxy and,
# in a production build, as the origin the dashboard calls directly.
VITE_API_URL=http://localhost:8000

# WebSocket endpoint for live monitoring. Leave unset to derive it from
# VITE_API_URL.
# VITE_WS_URL=ws://localhost:8000/ws/monitor
