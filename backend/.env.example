APP_NAME="InfoSec AI Monitor"
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_VERSION=1.0.0

# Dashboard and Frontend URLs
DASHBOARD_URL=https://your-domain.com/dashboard
PRIVACY_POLICY_URL=https://your-domain.com/privacy-policy

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=infosec_ai_monitor
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Security Configuration
# Shared HMAC secret. Must match `extensionSecret` in the browser extension and
# EXTENSION_SECRET in backend-python/.env if both backends run side by side.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
EXTENSION_SECRET=your_very_secure_secret_for_extension_auth
SIGNATURE_TOLERANCE_SECONDS=300
MINIMUM_EXTENSION_VERSION=1.0.0

# Data Retention and Privacy
DATA_RETENTION_DAYS=365
CONSENT_EXPIRY_DAYS=180
USES_COOKIES=false

# Alert Configuration
ALERTS_EMAIL_ENABLED=true
ALERTS_SLACK_ENABLED=false
ALERTS_WEBHOOK_ENABLED=false

# Email Recipients for Alerts
ALERTS_DEFAULT_RECIPIENTS="security@your-domain.com,admin@your-domain.com"
ALERTS_CRITICAL_RECIPIENTS="ciso@your-domain.com,security-team@your-domain.com"
ALERTS_HIGH_RECIPIENTS="security@your-domain.com"

# Slack Integration (if enabled)
ALERTS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Custom Webhook Integration (if enabled)
ALERTS_WEBHOOK_URL=https://your-internal-system.com/webhook/security-alerts
ALERTS_WEBHOOK_SECRET=your_webhook_secret

# Alert Assignment
ALERTS_ASSIGNEE_DATA_PROTECTION="data-protection-officer@your-domain.com"
ALERTS_ASSIGNEE_SECURITY_TEAM="security-team@your-domain.com"
ALERTS_ASSIGNEE_COMPLIANCE="compliance@your-domain.com"
ALERTS_ASSIGNEE_DEFAULT="security@your-domain.com"

# Business Hours for Alert Notifications
ALERTS_BUSINESS_HOURS_START=9
ALERTS_BUSINESS_HOURS_END=17
ALERTS_BUSINESS_DAYS="1,2,3,4,5"

# Risk Scoring
# Score (0-100) at which an interaction is promoted to each severity band.
RISK_THRESHOLD_MEDIUM=30
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_CRITICAL=85
# Lowest severity that will actually raise an alert.
ALERT_MINIMUM_SEVERITY=medium

# Suppress repeat alerts of the same type for one session inside this window.
ALERT_DEDUP_WINDOW_MINUTES=15

# Rate Limiting
# Requests per minute, except EXPORTS_RATE_LIMIT which is per hour.
EXTENSION_RATE_LIMIT=120
ALERTS_RATE_LIMIT=30
EXPORTS_RATE_LIMIT=20

# API Configuration
API_THROTTLE_ATTEMPTS=300
API_THROTTLE_DECAY_MINUTES=1

# Alert channel tuning
ALERTS_SLACK_CHANNEL="#security-alerts"
ALERTS_SLACK_USERNAME="InfoSec AI Monitor"
ALERTS_WEBHOOK_TIMEOUT=10
ALERTS_TIMEZONE=UTC
