# ---------------------------------------------------------------------------
# InfoSec AI Monitor - FastAPI backend configuration
#
# Copy to `.env` and fill in the values. Never commit the resulting file.
#
#   cp .env.example .env
#
# Generate the three secrets below with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | testing | production
ENVIRONMENT=development
APP_NAME="InfoSec AI Monitor"
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Security (REQUIRED in production) -------------------------------------
# Signs API access tokens. Must be at least 32 characters.
SECRET_KEY=

# Shared HMAC secret. Must match the value built into the browser extension.
EXTENSION_SECRET=

# Salt used when pseudonymising user identifiers. Changing this breaks the
# link to previously anonymised records - treat it as permanent.
ANONYMIZATION_SALT=

ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://infosec:change-me@localhost:5432/infosec_ai_monitor
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# Logs every SQL statement. Very verbose - development only.
DATABASE_ECHO=false

# --- Redis & Celery --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- CORS & trusted hosts --------------------------------------------------
# JSON arrays. Production origins must use HTTPS.
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# --- Privacy & retention ---------------------------------------------------
# Interactions are purged after this many days.
DATA_RETENTION_DAYS=365
# Users must re-affirm consent after this many days.
CONSENT_EXPIRY_DAYS=180

# --- Email notifications ---------------------------------------------------
ALERT_EMAIL_ENABLED=true
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_FROM=security@example.com

# JSON arrays. Recipients escalate with severity: a critical alert reaches
# DEFAULT + HIGH + CRITICAL.
ALERT_RECIPIENTS_DEFAULT=["security@example.com"]
ALERT_RECIPIENTS_HIGH=["security-team@example.com"]
ALERT_RECIPIENTS_CRITICAL=["ciso@example.com"]

# --- Slack notifications ---------------------------------------------------
ALERT_SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# --- Webhook / SIEM integration --------------------------------------------
ALERT_WEBHOOK_ENABLED=false
WEBHOOK_URL=
# Outbound payloads are signed with this key in an X-Signature header.
WEBHOOK_SECRET=

# --- Machine learning ------------------------------------------------------
# Directory holding persisted models. Unpickling executes code, so this must
# be a trusted, non-user-writable path.
ML_MODEL_PATH=models/
ML_BATCH_SIZE=32
ML_CONFIDENCE_THRESHOLD=0.7
ML_RETRAIN_INTERVAL_HOURS=24

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# --- Alert scheduling ------------------------------------------------------
# Non-critical alerts are held outside business hours. 0 = Monday.
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
BUSINESS_DAYS=[0,1,2,3,4]

# --- Monitoring ------------------------------------------------------------
ENABLE_METRICS=true
